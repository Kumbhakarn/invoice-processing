      },
      "ReadinessResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "database": {
            "type": "string",
            "title": "Database"
          }
        },
        "type": "object",
        "required": [
          "status",
          "database"
        ],
        "title": "ReadinessResponse",
        "description": "Application and database readiness status."
      },
      "SourceCandidate": {
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Page"
          },
          "boxes": {
            "items": {
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array",
              "maxItems": 4,
              "minItems": 4
            },
            "type": "array",
            "title": "Boxes"
          },
          "match_score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Match Score"
          },
          "evidence_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evidence Text"
          },
          "estimated": {
            "type": "boolean",
            "title": "Estimated",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "page",
          "boxes",
          "match_score"
        ],
        "title": "SourceCandidate",
        "description": "One possible source location for an extracted field."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "ValidationIssue": {
        "properties": {
          "rule_id": {
            "type": "string",
            "title": "Rule Id"
          },
          "field": {
            "type": "string",
            "title": "Field"
          },
          "line_item_index": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Line Item Index"
          },
          "severity": {
            "type": "string",
            "enum": [
              "warning",
              "error"
            ],
            "title": "Severity"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "rule_id",
          "field",
          "severity",
          "message"
        ],
        "title": "ValidationIssue",
        "description": "One non-mutating business rule finding."
      }
    }
  }
}