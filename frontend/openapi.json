{
  "openapi": "3.1.0",
  "info": {
    "title": "DocExtract API",
    "summary": "Invoice processing and extraction API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health Check",
        "description": "Report that the API process is responding.",
        "operationId": "health_check_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Readiness Check",
        "description": "Report whether the API and configured PostgreSQL database can serve requests.",
        "operationId": "readiness_check_api_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          },
          "503": {
            "description": "Database is unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/extract": {
      "post": {
        "tags": [
          "invoices"
        ],
        "summary": "Extract Invoice",
        "description": "Accept an invoice document and return AI-extracted structured data.",
        "operationId": "extract_invoice_api_extract_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_extract_invoice_api_extract_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvoiceExtractionData"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/extract/evidence": {
      "post": {
        "tags": [
          "invoices"
        ],
        "summary": "Extract Invoice Evidence",
        "description": "Return extraction values with grounded field evidence for review.",
        "operationId": "extract_invoice_evidence_api_extract_evidence_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_extract_invoice_evidence_api_extract_evidence_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvidenceExtractionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/validate": {
      "post": {
        "tags": [
          "invoices"
        ],
        "summary": "Validate Extracted Invoice",
        "description": "Check business consistency without changing the supplied invoice values.",
        "operationId": "validate_extracted_invoice_api_validate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InvoiceExtractionData"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvoiceValidationResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_extract_invoice_api_extract_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "An invoice PDF or image file"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_extract_invoice_api_extract_post"
      },
      "Body_extract_invoice_evidence_api_extract_evidence_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "An invoice PDF or image document"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_extract_invoice_evidence_api_extract_evidence_post"
      },
      "DocumentPage": {
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Page"
          },
          "width": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Width"
          },
          "height": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Height"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "page",
          "width",
          "height"
        ],
        "title": "DocumentPage",
        "description": "One-based document page and dimensions used for highlighting."
      },
      "EvidenceExtractionResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/InvoiceExtractionData"
          },
          "fields": {
            "additionalProperties": {
              "$ref": "#/components/schemas/MappedField"
            },
            "type": "object",
            "title": "Fields"
          },
          "pages": {
            "items": {
              "$ref": "#/components/schemas/DocumentPage"
            },
            "type": "array",
            "title": "Pages"
          },
          "meta": {
            "$ref": "#/components/schemas/EvidenceMetadata"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "data",
          "fields",
          "pages",
          "meta"
        ],
        "title": "EvidenceExtractionResponse",
        "description": "Interim evidence endpoint response, separate from `/api/extract`."
      },
      "EvidenceMetadata": {
        "properties": {
          "timings_ms": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Timings Ms"
          },
          "provider_usage": {
            "items": {
              "$ref": "#/components/schemas/ProviderUsageMetadata"
            },
            "type": "array",
            "title": "Provider Usage"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "EvidenceMetadata",
        "description": "Processing timings and provider usage for an evidence extraction."
      },
      "FieldSource": {
        "properties": {
          "page": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Page"
          },
          "boxes": {
            "items": {
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array",
              "maxItems": 4,
              "minItems": 4
            },
            "type": "array",
            "title": "Boxes"
          },
          "status": {
            "type": "string",
            "enum": [
              "located",
              "unavailable",
              "ambiguous"
            ],
            "title": "Status",
            "default": "unavailable"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "not_found",
                  "ambiguous",
                  "ocr_failed",
                  "low_quality"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason",
            "default": "not_found"
          },
          "match_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Match Count",
            "default": 0
          },
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/SourceCandidate"
            },
            "type": "array",
            "title": "Candidates"
          },
          "evidence_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evidence Text"
          },
          "estimated": {
            "type": "boolean",
            "title": "Estimated",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "FieldSource",
        "description": "Selected or unavailable source location, with ambiguity details."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "description": "Service health response."
      },
      "InvoiceExtractionData": {
        "properties": {
          "document_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Document Type"
          },
          "invoice_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Invoice Number"
          },
          "invoice_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Invoice Date"
          },
          "buyer_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Buyer Name"
          },
          "buyer_address": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
