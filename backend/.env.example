# Copy this file to .env and add your provider API keys.
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.5-flash
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_PDF_PAGES=50
MAX_IMAGE_WIDTH=10000
MAX_IMAGE_HEIGHT=10000
EVIDENCE_RENDER_DPI=200
EVIDENCE_TEXT_LAYER_MIN_CHARS=20
EVIDENCE_OCR_ENGINE=rapidocr
EVIDENCE_OCR_WORKERS=2
EVIDENCE_OCR_TIMEOUT_SECONDS=30
# Required only for PaddleOCR; preinstall models with det/ and rec/ subfolders.
# EVIDENCE_OCR_MODEL_DIR=./models/paddleocr
LOG_LEVEL=INFO
PROVIDER_PRICING_VERSION=unconfigured
# Optional JSON, for example: {"OpenAI":{"model-name":{"input_per_million_usd":1,"output_per_million_usd":2}}}
# Use the provider's current pricing and set PROVIDER_PRICING_VERSION to identify it.
PROVIDER_PRICING_JSON={}
