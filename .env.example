# Copy to .env before starting Compose. Keep credentials local and untracked.
POSTGRES_DB=docextract
POSTGRES_USER=docextract
POSTGRES_PASSWORD=change-this-local-password

OPENAI_API_KEY=
GEMINI_API_KEY=
OPENAI_MODEL=gpt-6-luna
GEMINI_MODEL=gemini-3.8-flash

MAX_UPLOAD_SIZE_BYTES=10485760
MAX_PDF_PAGES=50
MAX_IMAGE_WIDTH=10000
MAX_IMAGE_HEIGHT=10000
EVIDENCE_RENDER_DPI=200
EVIDENCE_TEXT_LAYER_MIN_CHARS=20
EVIDENCE_OCR_WORKERS=2
EVIDENCE_OCR_TIMEOUT_SECONDS=30
EVIDENCE_MATCH_THRESHOLD=0.82
EVIDENCE_MATCH_AMBIGUITY_MARGIN=0.05
LOG_LEVEL=INFO
PROVIDER_PRICING_VERSION=unconfigured
PROVIDER_PRICING_JSON={}

FRONTEND_PORT=8080
